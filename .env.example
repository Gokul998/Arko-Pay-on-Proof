# ── PayPal Sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ── Claude (console.anthropic.com) ──
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
ARKO_MODEL=claude-opus-5-5

# ── App ──
# API port in development (production uses the platform PORT)
API_PORT=8787
# Public URL of the app; PayPal redirects the payer back here after approval
PUBLIC_URL=http://localhost:5173
# Largest single money movement the approval gate will allow (USD)
MAX_ACTION_AMOUNT=5000
# Signs per-party deal keys (invite links). Required in production; auto-generated per data dir in dev.
APP_SECRET=
